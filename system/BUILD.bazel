load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# System configuration as Debian packages:
#
#   bazel build //system:backlight_deb
#   sudo dpkg -i bazel-bin/system/dotfiles-backlight_0.1_all.deb
#
# The version is fixed on purpose: dpkg reinstalls a package of the version
# it already has, which is what the install loop wants.
DEB_VERSION = "0.1"

DEB_MAINTAINER = "Philipp Schrader <dotfiles@philsc.net>"

# A package's udev rules go under /usr/lib, not /etc: /etc/udev/rules.d is
# the admin's, and a file of the same name there overrides this one.
pkg_files(
    name = "backlight_deb_rules",
    srcs = ["files/90-backlight.rules"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "usr/lib/udev/rules.d",
)

pkg_tar(
    name = "backlight_deb_data",
    srcs = [":backlight_deb_rules"],
    extension = "tar",
)

pkg_deb(
    name = "backlight_deb",
    architecture = "all",
    data = ":backlight_deb_data",
    depends = ["udev"],
    description = "Lets the video group control the display backlight",
    maintainer = DEB_MAINTAINER,
    package = "dotfiles-backlight",
    postinst = "deb/backlight.postinst",
    priority = "optional",
    section = "misc",
    version = DEB_VERSION,
)
