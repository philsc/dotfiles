load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# System configuration as Debian packages:
#
#   bazel build //system:backlight_deb
#   sudo dpkg -i bazel-bin/system/dotfiles-backlight_0.1_all.deb
#
# A package with dependencies goes through apt instead, which installs them
# where dpkg would only complain:
#
#   bazel build //system:ood_shares_deb
#   sudo apt install ./bazel-bin/system/dotfiles-ood-shares_0.1_all.deb
#
#   bazel build //system:redshift_deb
#   sudo apt install ./bazel-bin/system/dotfiles-redshift_0.1_all.deb
#
# The version is fixed on purpose: dpkg reinstalls a package of the version
# it already has, which is what the install loop wants.
DEB_VERSION = "0.1"

DEB_MAINTAINER = "Philipp Schrader <dotfiles@philsc.net>"

# A package's udev rules go under /usr/lib, not /etc: /etc/udev/rules.d is
# the admin's, and a file of the same name there overrides this one.
pkg_files(
    name = "backlight_deb_rules",
    srcs = ["files/90-backlight.rules"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "usr/lib/udev/rules.d",
)

pkg_tar(
    name = "backlight_deb_data",
    srcs = [":backlight_deb_rules"],
    extension = "tar",
)

pkg_deb(
    name = "backlight_deb",
    architecture = "all",
    data = ":backlight_deb_data",
    depends = ["udev"],
    description = "Lets the video group control the display backlight",
    maintainer = DEB_MAINTAINER,
    package = "dotfiles-backlight",
    postinst = "deb/backlight.postinst",
    priority = "optional",
    section = "misc",
    version = DEB_VERSION,
)

# Lazily mounts ood.local's samba shares under /share. Units, not fstab lines:
# /etc/fstab is the admin's file, and units come and go with the package.
pkg_files(
    name = "ood_shares_deb_units",
    srcs = [
        "files/share-mcat.automount",
        "files/share-mcat.mount",
        "files/share-media.automount",
        "files/share-media.mount",
    ],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "usr/lib/systemd/system",
)

pkg_tar(
    name = "ood_shares_deb_data",
    srcs = [":ood_shares_deb_units"],
    extension = "tar",
)

pkg_deb(
    name = "ood_shares_deb",
    architecture = "all",
    data = ":ood_shares_deb_data",
    # libnss-mdns is what resolves ood.local for mount.cifs.
    depends = [
        "cifs-utils",
        "libnss-mdns",
    ],
    description = "Mounts ood.local's samba shares under /share on first access",
    maintainer = DEB_MAINTAINER,
    package = "dotfiles-ood-shares",
    postinst = "deb/ood-shares.postinst",
    postrm = "deb/ood-shares.postrm",
    prerm = "deb/ood-shares.prerm",
    priority = "optional",
    # For browsing the shares without mounting: smbclient -N -L ood.local
    recommends = ["smbclient"],
    section = "misc",
    version = DEB_VERSION,
)

# Makes redshift usable under awesome: authorizes it with geoclue, which has no
# desktop agent there to ask, and widens Debian's AppArmor profile to the config
# path redshift 1.12 uses. The geoclue file goes under /etc as a conffile, since
# geoclue only reads drop-ins from /etc/geoclue/conf.d. The AppArmor snippet is
# copied into /etc/apparmor.d/local by the postinst, see there for why.
pkg_files(
    name = "redshift_deb_units",
    srcs = [
        "files/geoclue-agent.service",
        "files/redshift.service",
    ],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "usr/lib/systemd/user",
)

pkg_files(
    name = "redshift_deb_geoclue_conf",
    srcs = ["files/geoclue-redshift.conf"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "etc/geoclue/conf.d",
    renames = {"files/geoclue-redshift.conf": "redshift.conf"},
)

pkg_files(
    name = "redshift_deb_apparmor_local",
    srcs = ["files/apparmor-redshift.local"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "usr/share/dotfiles-redshift",
)

pkg_tar(
    name = "redshift_deb_data",
    srcs = [
        ":redshift_deb_apparmor_local",
        ":redshift_deb_geoclue_conf",
        ":redshift_deb_units",
    ],
    extension = "tar",
)

pkg_deb(
    name = "redshift_deb",
    architecture = "all",
    conffiles = ["/etc/geoclue/conf.d/redshift.conf"],
    data = ":redshift_deb_data",
    # The AppArmor override goes into a file redshift's postinst creates.
    depends = [
        "geoclue-2.0",
        "redshift",
    ],
    description = "Lets redshift read its config and get its location under awesome",
    maintainer = DEB_MAINTAINER,
    package = "dotfiles-redshift",
    postinst = "deb/redshift.postinst",
    postrm = "deb/redshift.postrm",
    priority = "optional",
    section = "misc",
    version = DEB_VERSION,
)
