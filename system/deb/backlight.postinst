#!/bin/sh
# postinst for dotfiles-backlight: pick the rule up without a reboot.
set -e

# Only where udev is running, which a chroot is not.
if [ "$1" = configure ] && [ -d /run/udev ]; then
    udevadm control --reload || true
    udevadm trigger --subsystem-match=backlight --action=add || true
fi

exit 0
