#!/bin/sh
# prerm for dotfiles-ood-shares: take the automounts down before the units go.
set -e

# Stopping an automount stops its mount too. A hung mount must not block
# removal, hence the || true.
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl disable --now share-media.automount share-mcat.automount || true
fi

exit 0
