# Redshift for the X session. Not enabled anywhere: it needs DISPLAY, which
# only exists once X is up, so ~/.xprofile imports the environment and
# restarts this unit at every login.
[Unit]
Description=Redshift display colour temperature adjustment
# Geoclue only answers once an agent is registered. After= only orders the
# process start; Restart= covers the rest of that race.
Wants=geoclue-agent.service
After=geoclue-agent.service

[Service]
ExecStart=/usr/bin/redshift
Restart=on-failure
RestartSec=1
