#!/bin/sh

# The Studio Display's 5K panel is about 218 DPI and awesome on X11 can't
# scale per screen, so double the font DPI while it's lit and go back to 96
# otherwise. Decided from xrandr rather than the profile name, so it's right
# however it's run. Apps only read the DPI at start, so awesome is restarted
# here (its windows stay open); other apps need reopening by hand.
if xrandr --query | grep -Eq ' connected (primary )?5120x2880\+'; then
  dpi=192
else
  dpi=96
fi
old=$(xrdb -query | sed -n 's/^Xft\.dpi:[[:space:]]*//p')
[ "$old" = "$dpi" ] && exit 0
echo "Xft.dpi: $dpi" | xrdb -merge

# autorandr's systemd service may not hand on the session bus that
# awesome-client talks over.
: "${DBUS_SESSION_BUS_ADDRESS:=unix:path=/run/user/$(id -u)/bus}"
export DBUS_SESSION_BUS_ADDRESS

# Restarting awesome under a blanked or locked xscreensaver restacks its
# windows above the lock's: the desktop shows, but xscreensaver keeps the
# keyboard and mouse, so it looks frozen (as on resuming without the Studio
# Display after a suspend). So wait until the screen is back, in the
# background so autorandr isn't held up. The flock keeps a second switch
# from queueing a second restart.
setsid -f flock -n "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/autorandr-awesome-restart" sh -c '
  while xscreensaver-command -time 2>/dev/null |
      grep -Eq " (blanked|locked) since"; do
    sleep 2
  done
  # Deferred, so awesome answers before it replaces itself.
  awesome-client "require(\"gears\").timer.delayed_call(awesome.restart)"
' >/dev/null 2>&1
